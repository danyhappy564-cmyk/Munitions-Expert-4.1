<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>IcyClawz.CustomInteractions</AssemblyName>
    <Version>1.8.0</Version>
    <RootNamespace>IcyClawz.CustomInteractions</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Was $(SharedDir)\Assembly-CSharp-CustomInteractions.dll - a prepatched copy of the game
      assembly that nobody could produce from a fresh clone. Nothing here needs the prepatch
      any more, so reference the install directly.
    -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(SptBepInEx)\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptManaged)\Comfort.dll</HintPath>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(SptManaged)\Sirenix.Serialization.dll</HintPath>
    </Reference>
    <Reference Include="SPT.Reflection">
      <HintPath>$(SptBepInEx)\plugins\spt\spt-reflection.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptManaged)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
