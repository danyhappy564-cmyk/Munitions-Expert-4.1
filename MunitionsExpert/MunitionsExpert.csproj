<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>IcyClawz.MunitionsExpert</AssemblyName>
    <Version>1.7.0</Version>
    <RootNamespace>IcyClawz.MunitionsExpert</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!--
      The one project that stays on net472 rather than the solution-wide netstandard2.1.
      Resources.resx holds three PNGs and Resources.Designer.cs types them as
      System.Drawing.Bitmap, which ImageExtensions.ToSprite re-encodes to PNG bytes for
      Unity. System.Drawing does not exist on netstandard2.1, and the resx path there needs
      the preserialized resource writer on top - so the icons would have to be reworked to
      raw bytes to move this project over. BepInEx loads net472 plugins on Mono perfectly
      well, and this is what upstream shipped, so leave it and keep the change to the port.
    -->
    <TargetFramework>net472</TargetFramework>
    <!--
      Modern SDKs dropped BinaryFormatter-based resource writing outright, so the PNGs in
      Resources.resx need the preserialized writer and its package even on net472
      (MSB3822/MSB3823).
    -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(SptBepInEx)\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptManaged)\Comfort.dll</HintPath>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(SptManaged)\Sirenix.Serialization.dll</HintPath>
    </Reference>
    <Reference Include="SPT.Reflection">
      <HintPath>$(SptBepInEx)\plugins\spt\spt-reflection.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(SptManaged)\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptManaged)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(SptManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(SptManaged)\UnityEngine.UI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
